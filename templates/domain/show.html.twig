{% extends 'dashboard/layout.html.twig' %}

{% block title %}{{ domain.name }}{% endblock %}
{% block page_title %}
    <span class="flex items-center gap-3">
        <span class="flex size-10 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600"><twig:ux:icon :name="domain.icon" class="size-6" /></span>
        {{ domain.name }}
    </span>
{% endblock %}

{% block page_actions %}
    {% if pending is not null %}
        <a href="{{ path('app_validation_index', {slug: domain.slug}) }}" class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
            <twig:ux:icon name="lucide:circle-check" class="size-4" /> Validation ({{ pending }})
        </a>
    {% endif %}
    {% if is_granted('DOMAIN_EVALUATE', domain) %}
        <a href="{{ path('app_evaluation_entry', {slug: domain.slug}) }}" class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">
            <twig:ux:icon name="lucide:pencil-line" class="size-4" /> Saisie de la semaine
        </a>
    {% endif %}
{% endblock %}

{% block content %}
    {{ include('partials/_week_nav.html.twig', {route: 'app_domain_show', params: {slug: domain.slug}}) }}

    <section aria-labelledby="kpi-charts-title" class="space-y-3">
        <h2 id="kpi-charts-title" class="text-sm font-semibold text-gray-900">Évolution valeur / objectif par KPI <span class="font-normal text-gray-500">({{ chartWeekCount }} semaines jusqu'au {{ week|date('d/m/Y') }})</span></h2>
        <div class="grid gap-4 xl:grid-cols-2">
            {% for sub in domain.kpis %}
                {% if sub.active %}
                    {% set chart = charts[sub.id] ?? null %}
                    <div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
                        <div class="mb-2 flex items-start justify-between gap-3">
                            <p class="min-w-0"><span class="font-semibold text-gray-900">{{ sub.code }}</span> <span class="text-sm text-gray-500">{{ sub.name }}</span></p>
                            {% if sub.unit %}<span class="shrink-0 rounded bg-gray-100 px-2 py-0.5 text-xs text-gray-600">{{ sub.unit }}</span>{% endif %}
                        </div>
                        {% if chart %}
                            <div class="relative h-44">{{ render_chart(chart) }}</div>
                        {% else %}
                            <p class="flex h-44 items-center justify-center gap-2 text-sm text-gray-400"><twig:ux:icon name="lucide:inbox" class="size-5" /> Aucune valeur soumise sur cette période.</p>
                        {% endif %}
                    </div>
                {% endif %}
            {% else %}
                <p class="text-sm text-gray-500">Aucun KPI dans ce domaine.</p>
            {% endfor %}
        </div>
    </section>

    <twig:Dashboard:Card title="Taux d'atteinte des dernières semaines">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="text-xs uppercase text-gray-500">
                    <tr>
                        <th class="pb-3 pr-4">KPI</th>
                        <th class="pb-3 pr-4">Objectif actuel</th>
                        {% for week in weeks %}<th class="pb-3 pr-4 text-center">{{ week|date('d/m') }}</th>{% endfor %}
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for sub in domain.kpis %}
                        {% if sub.active %}
                            <tr>
                                <td class="py-3 pr-4"><span class="font-medium">{{ sub.code }}</span> <span class="text-gray-500">{{ sub.name }}</span></td>
                                <td class="py-3 pr-4">{{ sub.defaultTarget|number_format(0, ',', ' ') }}{{ sub.unit ? ' ' ~ sub.unit : '' }}</td>
                                {% for week in weeks %}
                                    {% set evaluation = grid[sub.id][week|date('Y-m-d')] ?? null %}
                                    <td class="py-3 pr-4 text-center">
                                        {% if evaluation and evaluation.achievement is not null %}
                                            {% set rate = evaluation.achievement %}
                                            <twig:Dashboard:Badge :variant="rate >= 100 ? 'success' : (rate >= 80 ? 'warning' : 'danger')" title="{{ evaluation.score }} / {{ evaluation.target }} · {{ evaluation.status.label }}">{{ rate|round }}%</twig:Dashboard:Badge>
                                        {% else %}
                                            <span class="text-gray-300">—</span>
                                        {% endif %}
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endif %}
                    {% else %}
                        <tr><td colspan="8" class="py-6 text-center text-gray-500">Aucun KPI.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </twig:Dashboard:Card>
{% endblock %}
