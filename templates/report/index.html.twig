{% extends 'dashboard/layout.html.twig' %}

{% block title %}Rapports{% endblock %}
{% block page_title %}Rapports{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_report_export', criteria.queryParams) }}" class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">
        <twig:ux:icon name="lucide:download" class="size-4" /> Exporter en CSV
    </a>
{% endblock %}

{% block content %}
    <twig:Dashboard:Card>
        <form method="get" action="{{ path('app_report_index') }}" class="grid items-end gap-4 sm:grid-cols-2 xl:grid-cols-5">
            <div class="space-y-1">
                <label for="report-from" class="block text-sm font-medium text-gray-700">Du (semaine)</label>
                <input type="date" id="report-from" name="from" value="{{ criteria.from|date('Y-m-d') }}" class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100">
            </div>
            <div class="space-y-1">
                <label for="report-to" class="block text-sm font-medium text-gray-700">Au (semaine)</label>
                <input type="date" id="report-to" name="to" value="{{ criteria.to|date('Y-m-d') }}" class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100">
            </div>
            <div class="space-y-1">
                <label for="report-domain" class="block text-sm font-medium text-gray-700">Domaine</label>
                <select id="report-domain" name="domain" class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100">
                    <option value="">Tous mes domaines</option>
                    {% for domain in domains %}
                        <option value="{{ domain.id }}"{{ criteria.domain and criteria.domain.id == domain.id ? ' selected' : '' }}>{{ domain.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="space-y-1">
                <label for="report-status" class="block text-sm font-medium text-gray-700">Évaluations</label>
                <select id="report-status" name="status" class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100">
                    <option value="reportable"{{ criteria.status == 'reportable' ? ' selected' : '' }}>Soumises et validées</option>
                    <option value="validated"{{ criteria.status == 'validated' ? ' selected' : '' }}>Validées uniquement</option>
                    <option value="all"{{ criteria.status == 'all' ? ' selected' : '' }}>Toutes (brouillons compris)</option>
                </select>
            </div>
            <button type="submit" class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700">Filtrer</button>
        </form>
        <p class="mt-3 text-xs text-gray-500">
            Période : semaines du {{ criteria.from|date('d/m/Y') }} au {{ criteria.to|date('d/m/Y') }} ({{ criteria.weekCount }} semaine{{ criteria.weekCount > 1 ? 's' : '' }}).
            {% if criteria.clamped %}<span class="text-amber-700">La période a été raccourcie à {{ constant('App\\Report\\ReportCriteria::MAX_WEEKS') }} semaines maximum.</span>{% endif %}
        </p>
    </twig:Dashboard:Card>

    <twig:Dashboard:Card title="Synthèse par domaine">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="text-xs uppercase text-gray-500">
                    <tr>
                        <th class="pb-3 pr-4">Domaine</th>
                        <th class="pb-3 pr-4">Évaluations</th>
                        <th class="pb-3 pr-4">Dont validées</th>
                        <th class="pb-3 pr-4">Atteinte moyenne</th>
                        <th class="pb-3">À l'objectif</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for stat in result.stats %}
                        <tr>
                            <td class="py-3 pr-4 font-medium">
                                <span class="flex items-center gap-2"><twig:ux:icon :name="stat.domain.icon" class="size-4 text-indigo-600" /> {{ stat.domain.name }}</span>
                            </td>
                            <td class="py-3 pr-4">{{ stat.count }}</td>
                            <td class="py-3 pr-4">{{ stat.validatedCount }}</td>
                            <td class="py-3 pr-4">
                                {% if stat.average is not null %}
                                    <twig:Dashboard:Badge :variant="stat.average >= 100 ? 'success' : (stat.average >= 80 ? 'warning' : 'danger')">{{ stat.average|round(1) }} %</twig:Dashboard:Badge>
                                {% else %}—{% endif %}
                            </td>
                            <td class="py-3">{{ stat.atTargetRate is not null ? stat.atTargetRate|round(1) ~ ' %' : '—' }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="py-6 text-center text-gray-500">Aucun domaine accessible.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </twig:Dashboard:Card>

    <twig:Dashboard:Card title="Détail ({{ result.rows|length }} ligne{{ result.rows|length > 1 ? 's' : '' }})">
        {% if result.rows is empty %}
            <p class="flex items-center gap-2 py-6 text-sm text-gray-500"><twig:ux:icon name="lucide:inbox" class="size-5" /> Aucune évaluation sur cette période.</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="text-xs uppercase text-gray-500">
                        <tr>
                            <th class="pb-3 pr-4">Semaine</th>
                            <th class="pb-3 pr-4">Domaine</th>
                            <th class="pb-3 pr-4">KPI</th>
                            <th class="pb-3 pr-4">Score / objectif</th>
                            <th class="pb-3 pr-4">Atteinte</th>
                            <th class="pb-3 pr-4">Statut</th>
                            <th class="pb-3">Saisi par</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for evaluation in result.rows|slice(0, displayLimit) %}
                            {% set rate = evaluation.achievement %}
                            <tr>
                                <td class="whitespace-nowrap py-2 pr-4">{{ evaluation.weekStart|date('d/m/Y') }}</td>
                                <td class="py-2 pr-4">{{ evaluation.kpi.domain.name }}</td>
                                <td class="py-2 pr-4"><span class="font-medium">{{ evaluation.kpi.code }}</span> <span class="text-gray-500">{{ evaluation.kpi.name }}</span></td>
                                <td class="whitespace-nowrap py-2 pr-4">{{ evaluation.score is not null ? evaluation.score : '—' }} / {{ evaluation.target }}{{ evaluation.kpi.unit ? ' ' ~ evaluation.kpi.unit : '' }}</td>
                                <td class="py-2 pr-4">
                                    {% if rate is not null %}
                                        <twig:Dashboard:Badge :variant="rate >= 100 ? 'success' : (rate >= 80 ? 'warning' : 'danger')">{{ rate|round }}%</twig:Dashboard:Badge>
                                    {% else %}—{% endif %}
                                </td>
                                <td class="py-2 pr-4">
                                    <twig:Dashboard:Badge :variant="evaluation.status.value == 'validated' ? 'success' : (evaluation.status.value == 'submitted' ? 'warning' : 'neutral')">{{ evaluation.status.label }}</twig:Dashboard:Badge>
                                </td>
                                <td class="py-2 text-gray-600">{{ evaluation.createdBy ? evaluation.createdBy.fullName : '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if result.rows|length > displayLimit %}
                <p class="mt-3 text-xs text-amber-700">Seules les {{ displayLimit }} premières lignes sont affichées : l'export CSV contient les {{ result.rows|length }} lignes.</p>
            {% endif %}
        {% endif %}
    </twig:Dashboard:Card>
{% endblock %}
