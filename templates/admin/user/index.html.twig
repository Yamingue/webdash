{% extends 'dashboard/layout.html.twig' %}

{% block title %}Utilisateurs{% endblock %}
{% block page_title %}Utilisateurs{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_admin_user_new') }}" class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">
        <twig:ux:icon name="lucide:user-plus" class="size-4" /> Nouvel utilisateur
    </a>
{% endblock %}

{% block content %}
    <twig:Dashboard:Card>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="text-xs uppercase text-gray-500">
                    <tr><th class="pb-3">Nom</th><th class="pb-3">Email</th><th class="pb-3">Accès</th><th class="pb-3"></th></tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for user in users %}
                        <tr>
                            <td class="py-3 font-medium">{{ user.fullName }}</td>
                            <td class="py-3 text-gray-600">{{ user.email }}</td>
                            <td class="py-3">
                                <div class="flex flex-wrap gap-1">
                                    {% if user.isAdmin %}<twig:Dashboard:Badge variant="danger">Administrateur</twig:Dashboard:Badge>{% endif %}
                                    {% if 'ROLE_DIRECTOR' in user.roles %}<twig:Dashboard:Badge variant="warning">Directeur</twig:Dashboard:Badge>{% endif %}
                                    {% for membership in user.memberships %}
                                        <twig:Dashboard:Badge>{{ membership.domain.name }} · {{ membership.role.label }}</twig:Dashboard:Badge>
                                    {% endfor %}
                                </div>
                            </td>
                            <td class="py-3 text-right"><a href="{{ path('app_admin_user_edit', {id: user.id}) }}" class="text-indigo-600 hover:underline">Modifier</a></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </twig:Dashboard:Card>
{% endblock %}
