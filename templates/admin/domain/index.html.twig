{% extends 'dashboard/layout.html.twig' %}

{% block title %}Domaines{% endblock %}
{% block page_title %}Domaines{% endblock %}

{% block page_actions %}
    <a href="{{ path('app_admin_domain_new') }}" class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700">
        <twig:ux:icon name="lucide:plus" class="size-4" /> Nouveau domaine
    </a>
{% endblock %}

{% block content %}
    <twig:Dashboard:Card>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="text-xs uppercase text-gray-500">
                    <tr><th class="pb-3">Menu</th><th class="pb-3">KPI</th><th class="pb-3">Ordre</th><th class="pb-3">Statut</th><th class="pb-3"></th></tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for domain in domains %}
                        <tr>
                            <td class="py-3">
                                <span class="flex items-center gap-3 font-medium">
                                    <span class="flex size-9 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600"><twig:ux:icon :name="domain.icon" class="size-5" /></span>
                                    {{ domain.name }}
                                </span>
                            </td>
                            <td class="py-3 text-gray-600">
                                {% for sub in domain.kpis %}<span class="mr-1 inline-block rounded bg-gray-100 px-2 py-0.5 text-xs">{{ sub.code }}</span>{% else %}—{% endfor %}
                            </td>
                            <td class="py-3">{{ domain.position }}</td>
                            <td class="py-3">
                                <twig:Dashboard:Badge :variant="domain.active ? 'success' : 'neutral'">{{ domain.active ? 'Active' : 'Inactive' }}</twig:Dashboard:Badge>
                            </td>
                            <td class="py-3">
                                <div class="flex items-center justify-end gap-3">
                                    <a href="{{ path('app_admin_domain_edit', {id: domain.id}) }}" class="text-indigo-600 hover:underline">Modifier</a>
                                    <form method="post" action="{{ path('app_admin_domain_delete', {id: domain.id}) }}" onsubmit="return confirm('Supprimer ce domaine ?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_domain_' ~ domain.id) }}">
                                        <button type="submit" class="text-rose-600 hover:underline">Supprimer</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="py-6 text-center text-gray-500">Aucun domaine.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </twig:Dashboard:Card>
{% endblock %}
