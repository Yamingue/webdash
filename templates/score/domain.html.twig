{% extends 'dashboard/layout.html.twig' %}

{% block title %}Calcul — {{ domain.name }}{% endblock %}
{% block page_title %}Calcul du score · {{ domain.name }}{% endblock %}

{% block page_actions %}
    {{ include('partials/_week_nav.html.twig', {route: 'app_score_domain', params: {slug: domain.slug}}) }}
{% endblock %}

{% block content %}
    {% set rows = explanation.rows %}
    <twig:Dashboard:Card title="Résultat">
        <p class="text-3xl font-semibold text-gray-900" data-testid="domain-score">{{ explanation.score is not null ? explanation.score|round(1) ~ ' %' : '—' }}</p>
        {% if explanation.score is null %}
            <p class="mt-1 text-sm text-gray-500">Aucun KPI n'entre dans le calcul cette semaine : pas de score.</p>
        {% else %}
            <p class="mt-2 text-sm text-gray-700" data-testid="domain-formula">
                = ({{ rows|map(r => r.counted|round(1) ~ ' × ' ~ r.weight|round(2))|join(' + ') }})
                ÷ ({{ rows|map(r => r.weight|round(2))|join(' + ') }})
                = {{ explanation.weightedSum|round(1) }} ÷ {{ explanation.totalWeight|round(2) }}
            </p>
        {% endif %}
        <p class="mt-2 text-xs text-gray-500">Moyenne pondérée des taux retenus (plafonnés à {{ cap|round }} %). <a href="{{ path('app_score_help') }}" class="text-indigo-600 hover:underline">Voir les règles</a></p>
    </twig:Dashboard:Card>

    <twig:Dashboard:Card title="KPI pris en compte ({{ rows|length }})">
        {% if rows is empty %}
            <p class="py-4 text-sm text-gray-500">Aucune évaluation soumise ou validée pour cette semaine.</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="text-xs uppercase text-gray-500">
                        <tr>
                            <th class="pb-3 pr-4">KPI</th>
                            <th class="pb-3 pr-4">Score / objectif</th>
                            <th class="pb-3 pr-4">Taux</th>
                            <th class="pb-3 pr-4">Taux retenu</th>
                            <th class="pb-3 pr-4">Poids</th>
                            <th class="pb-3">Poids × taux retenu</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for row in rows %}
                            <tr>
                                <td class="py-2 pr-4"><span class="font-medium">{{ row.kpi.code }}</span> <span class="text-gray-500">{{ row.kpi.name }}</span>
                                    {% if row.evaluation.lowerIsBetter %}<span class="text-xs text-gray-500">(plus bas = mieux)</span>{% endif %}</td>
                                <td class="whitespace-nowrap py-2 pr-4">{{ row.evaluation.score|round(2) }} / {{ row.evaluation.lowerIsBetter ? '≤ ' : '' }}{{ row.evaluation.target|round(2) }}{{ row.kpi.unit ? ' ' ~ row.kpi.unit : '' }}</td>
                                <td class="py-2 pr-4">{{ row.rate|round(1) }} %</td>
                                <td class="py-2 pr-4">{{ row.counted|round(1) }} %{% if row.capped %} <span class="text-xs text-amber-700">(plafonné)</span>{% endif %}</td>
                                <td class="py-2 pr-4">{{ row.weight|round(2) }}</td>
                                <td class="py-2">{{ row.contribution|round(1) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                    <tfoot class="border-t border-gray-200 text-sm font-medium">
                        <tr>
                            <td class="pt-2 pr-4" colspan="4">Total</td>
                            <td class="pt-2 pr-4">{{ explanation.totalWeight|round(2) }}</td>
                            <td class="pt-2">{{ explanation.weightedSum|round(1) }}</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        {% endif %}
    </twig:Dashboard:Card>

    {% if explanation.excluded is not empty %}
        <twig:Dashboard:Card title="KPI écartés du calcul ({{ explanation.excluded|length }})">
            <ul class="divide-y divide-gray-100 text-sm">
                {% for item in explanation.excluded %}
                    <li class="flex flex-wrap items-center justify-between gap-2 py-2">
                        <span><span class="font-medium">{{ item.kpi.code }}</span> <span class="text-gray-500">{{ item.kpi.name }}</span></span>
                        <span class="text-gray-500">{{ item.reason }}</span>
                    </li>
                {% endfor %}
            </ul>
        </twig:Dashboard:Card>
    {% endif %}

    <p class="text-sm"><a href="{{ path('app_domain_show', {slug: domain.slug}) }}" class="text-indigo-600 hover:underline">← Retour au domaine</a></p>
{% endblock %}
