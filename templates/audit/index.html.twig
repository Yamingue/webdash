{% extends 'dashboard/layout.html.twig' %}

{% block title %}Journal{% endblock %}
{% block page_title %}Journal d'audit{% endblock %}

{% block content %}
    <twig:Dashboard:Card>
        <form method="get" action="{{ path('app_audit_index') }}" class="grid items-end gap-4 sm:grid-cols-3">
            <div class="space-y-1">
                <label for="audit-domain" class="block text-sm font-medium text-gray-700">Domaine</label>
                <select id="audit-domain" name="domain" class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100">
                    <option value="">Tous</option>
                    {% for d in domains %}
                        <option value="{{ d.id }}"{{ domain and domain.id == d.id ? ' selected' : '' }}>{{ d.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="space-y-1">
                <label for="audit-action" class="block text-sm font-medium text-gray-700">Type d'événement</label>
                <select id="audit-action" name="action" class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100">
                    <option value="">Tous</option>
                    {% for a in actions %}
                        <option value="{{ a.value }}"{{ action and action == a ? ' selected' : '' }}>{{ a.label }}</option>
                    {% endfor %}
                </select>
            </div>
            <button type="submit" class="rounded-lg bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700">Filtrer</button>
        </form>
    </twig:Dashboard:Card>

    <twig:Dashboard:Card title="Derniers événements ({{ entries|length }})">
        {% if entries is empty %}
            <p class="flex items-center gap-2 py-6 text-sm text-gray-500"><twig:ux:icon name="lucide:inbox" class="size-5" /> Aucun événement enregistré.</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="text-xs uppercase text-gray-500">
                        <tr>
                            <th class="pb-3 pr-4">Date</th>
                            <th class="pb-3 pr-4">Auteur</th>
                            <th class="pb-3 pr-4">Domaine</th>
                            <th class="pb-3 pr-4">Événement</th>
                            <th class="pb-3">Détail</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for entry in entries %}
                            <tr class="align-top">
                                <td class="whitespace-nowrap py-2 pr-4 text-gray-600">{{ entry.createdAt|date('d/m/Y H:i') }}</td>
                                <td class="py-2 pr-4">{{ entry.actorName }}</td>
                                <td class="py-2 pr-4">{{ entry.domain ? entry.domain.name : '—' }}</td>
                                <td class="py-2 pr-4"><twig:Dashboard:Badge :variant="entry.action.badgeVariant">{{ entry.action.label }}</twig:Dashboard:Badge></td>
                                <td class="py-2 text-gray-700">{{ entry.summary }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if entries|length >= limit %}
                <p class="mt-3 text-xs text-gray-500">Seuls les {{ limit }} événements les plus récents sont affichés. Utilisez les filtres pour affiner.</p>
            {% endif %}
        {% endif %}
    </twig:Dashboard:Card>
{% endblock %}
