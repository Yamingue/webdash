{% props label, value, icon, trend = null, trendLabel = 'pts vs sem. préc.', hint = null %}
<div {{ attributes.defaults({class: 'flex flex-col items-center justify-center rounded-xl border border-gray-200 bg-white p-4 text-center shadow-sm'}) }}>
    <span class="flex size-11 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
        <twig:ux:icon :name="icon" class="size-6" />
    </span>
    <p class="mt-2 text-4xl font-semibold leading-none text-gray-900">{{ value }}</p>
    <p class="mt-2 text-base font-medium text-gray-600">{{ label }}</p>
    {% if trend is not null %}
        <p class="mt-1 flex items-center justify-center gap-1 text-sm {{ trend >= 0 ? 'text-emerald-600' : 'text-rose-600' }}">
            <twig:ux:icon :name="trend >= 0 ? 'lucide:trending-up' : 'lucide:trending-down'" class="size-4" />
            {{ trend > 0 ? '+' : '' }}{{ trend }} {{ trendLabel }}
        </p>
    {% elseif hint %}
        <p class="mt-1 text-sm text-gray-500">{{ hint }}</p>
    {% endif %}
</div>
