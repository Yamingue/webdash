{# Carte d'un domaine : en-tête, onglets « KPIs renseignés » / « Tous », une barre par KPI. Variable : summary (DomainSummary). #}
{% set pills = {good: 'bg-emerald-50 text-emerald-700', mid: 'bg-amber-50 text-amber-700', bad: 'bg-rose-50 text-rose-700'} %}
{% set avg = summary.average %}
{% set id = 'domain-' ~ summary.domain.id %}
<section class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm" aria-labelledby="{{ id }}" data-controller="tabs">
    <header class="flex items-center justify-between gap-3">
        <a href="{{ path('app_domain_show', {slug: summary.domain.slug}) }}" class="flex min-w-0 items-center gap-2 hover:text-indigo-600">
            <twig:ux:icon :name="summary.domain.icon" class="size-5 shrink-0 text-gray-500" />
            <h2 id="{{ id }}" class="truncate text-base font-semibold text-gray-900">{{ summary.domain.name }}</h2>
        </a>
        <div class="flex shrink-0 items-center gap-2">
            {% if summary.pending %}
                <a href="{{ path('app_validation_index', {slug: summary.domain.slug}) }}" class="rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 hover:bg-amber-100">{{ summary.pending }} à valider</a>
            {% endif %}
            {% if avg is not null %}
                <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold {{ pills[avg >= 100 ? 'good' : (avg >= 80 ? 'mid' : 'bad')] }}" title="Atteinte moyenne pondérée (taux plafonnés à 120 %){% if summary.trend is not null %} ({{ summary.trend > 0 ? '+' : '' }}{{ summary.trend }} pts vs semaine précédente){% endif %}">{{ avg|round }} %</span>
            {% endif %}
        </div>
    </header>

    <div role="tablist" aria-label="KPI de {{ summary.domain.name }}" class="mt-3 flex gap-6 border-b border-gray-200 text-sm" data-action="keydown->tabs#key">
        <button type="button" role="tab" id="{{ id }}-tab-0" aria-controls="{{ id }}-panel-0" aria-selected="true" data-tabs-target="tab" data-action="tabs#show"
                class="-mb-px border-b-2 border-transparent pb-2 font-medium text-gray-500 hover:text-gray-700 aria-selected:border-indigo-500 aria-selected:text-indigo-600">KPIs renseignés</button>
        <button type="button" role="tab" id="{{ id }}-tab-1" aria-controls="{{ id }}-panel-1" aria-selected="false" tabindex="-1" data-tabs-target="tab" data-action="tabs#show"
                class="-mb-px border-b-2 border-transparent pb-2 font-medium text-gray-500 hover:text-gray-700 aria-selected:border-indigo-500 aria-selected:text-indigo-600">Tous ({{ summary.historyRowCount }})</button>
    </div>

    <div role="tabpanel" id="{{ id }}-panel-0" aria-labelledby="{{ id }}-tab-0" data-tabs-target="panel" class="mt-3">
        <ul class="space-y-2.5">
            {% for line in summary.latest %}{{ include('dashboard/_kpi_bar.html.twig', {line: line, showWeek: line.evaluation and line.evaluation.weekStart != week}) }}{% else %}
                <li class="py-2 text-center text-xs text-gray-500">Aucun KPI renseigné pour le moment.</li>
            {% endfor %}
        </ul>
    </div>
    <div role="tabpanel" id="{{ id }}-panel-1" aria-labelledby="{{ id }}-tab-1" data-tabs-target="panel" class="mt-3" hidden>
        <ul class="space-y-2.5">
            {% for group in summary.history %}
                <li class="{{ loop.first ? '' : 'pt-2 ' }}text-xs font-semibold uppercase tracking-wide text-gray-400" role="presentation">Semaine du {{ group.week|date('d/m/Y') }}</li>
                {% for line in group.lines %}{{ include('dashboard/_kpi_bar.html.twig', {line: line}) }}{% endfor %}
            {% else %}
                <li class="py-2 text-center text-xs text-gray-500">Aucune semaine renseignée pour le moment.</li>
            {% endfor %}
        </ul>
    </div>
</section>
