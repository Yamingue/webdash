{% extends 'dashboard/layout.html.twig' %}

{% block title %}Tableau de bord{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}

{% block page_actions %}
    {{ include('partials/_week_nav.html.twig', {route: 'app_dashboard', params: {}}) }}
{% endblock %}

{% block content %}
    {% if summaries is empty %}
        <twig:Dashboard:Card>
            <p class="flex items-center gap-2 py-6 text-sm text-gray-500">
                <twig:ux:icon name="lucide:inbox" class="size-5" /> Aucun domaine accessible. Contactez un administrateur pour être rattaché à un domaine.
            </p>
        </twig:Dashboard:Card>
    {% else %}
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
            <twig:Dashboard:Gauge label="Score global pondéré" shape="half" :toned="true" :value="overall" :trend="overallTrend" :detailUrl="path('app_score_global', {week: week|date('Y-m-d')})" class="justify-center border-t-4 border-t-moov-blue" />
            {% for status in statuses %}
                <twig:Dashboard:StatusCard :status="status.value" :count="board.count(status)" :label="status.label" :subtitle="status.subtitle" :breakdown="board.breakdown(status)" />
            {% endfor %}
        </div>

        <p class="-mt-2 text-right text-xs"><a href="{{ path('app_score_help') }}" class="text-indigo-600 hover:underline">Comment les scores sont calculés ?</a></p>

        <div class="grid gap-4 xl:grid-cols-2">
            {% for summary in summaries %}{{ include('dashboard/_domain_card.html.twig', {summary: summary}) }}{% endfor %}
        </div>
    {% endif %}
{% endblock %}
