{% extends 'base.html.twig' %}

{% block body %}
    <div data-controller="sidebar">
        <twig:Dashboard:Sidebar />
        <div class="lg:pl-64">
            <twig:Dashboard:Topbar />
            <main class="space-y-6 p-4 sm:p-6">
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <p role="status" class="rounded-lg px-4 py-3 text-sm {{ type == 'success' ? 'bg-emerald-50 text-emerald-700' : (type == 'warning' ? 'bg-amber-50 text-amber-700' : 'bg-rose-50 text-rose-700') }}">{{ message }}</p>
                    {% endfor %}
                {% endfor %}
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <h1 class="text-2xl font-semibold">{% block page_title %}{% endblock %}</h1>
                    {% block page_actions %}{% endblock %}
                </div>
                {% block content %}{% endblock %}
            </main>
        </div>
    </div>
{% endblock %}
